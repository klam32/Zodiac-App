@startuml Zodiac_Whisper_Full_RAG_Flow

title Zodiac Whisper - INIT to FOLLOW-UP RAG Flow
skinparam shadowing false
skinparam activity {
  BackgroundColor #ffffff
  BorderColor #1f2937
  ArrowColor #1f2937
}
skinparam note {
  BackgroundColor #eef6ff
  BorderColor #2563eb
}

start
:A. User enters information / question;
:B. Frontend React + Vite;
note right
  Sends REST API request
  with JWT authentication.
end note
:C. Backend FastAPI;

if (D. Mode?) then (INIT / First Time)
  partition "INIT / First Time" {
    :E. AstrologyAgent;
    :F. Kerykeion calculates natal chart;
    :G. Chart SVG + astrology data;
    :H. Vertex AI Gemini generates interpretation;

    fork
      :I. Save chat + chart into DB;
    fork again
      :J. RAG ingestion background;
      :J1. Chunk Markdown;
      :J2. Vertex AI Embedding;
      :J3. Store chunks into DB;
      note right
        These INIT chunks are the source
        that follow-up questions must retrieve.
      end note
    end fork

    :K. Return chart + interpretation to Frontend;
  }
else (FOLLOW-UP)
  partition "FOLLOW-UP / Follow-up Question" {
    :L. GuardAgent moderation;
    if (M. Valid question?) then (No)
      :N. Refuse response;
      stop
    else (Yes)
      :O. Analyze intent;

      fork
        :P. RAG retrieval from INIT chunks;
        if (P0. INIT chunks exist?) then (Yes)
        else (No)
          :Build chunks from first chart log;
        endif
        :P1. Embed question;
        :P2. Cosine Similarity Top 5;
        :P3. Rerank Top 3;
      fork again
        :Q. GraphRAG;
        :Q1. Extract astrology entities;
        :Q2. Neo4j / NetworkX;
        :Q3. Graph facts;
      end fork

      :R. Compose final_question;
      note right
        final_question = user question
        + RAG chunks from initial chart
        + GraphRAG facts.
      end note

      :S. AISystem Orchestrator;
      :T. Multi-Agent parallel execution;
      split
        :T1. CareerAgent;
      split again
        :T2. LoveAgent;
      split again
        :T3. HealthAgent;
      split again
        :T4. PersonalityAgent;
      split again
        :T5. DailyAgent;
      end split

      :U. Fusion LLM / Direct Answer;
      :V. Save response into DB;
      :W. Return response to Frontend;
    endif
  }
endif

stop

@enduml
